<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guarantee</groupId>
        <artifactId>guarantee-ai-admin</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>guarantee-ai</artifactId>
    <name>guarantee-ai</name>
    <description>AI 基础能力：会话、SSE 流式聊天、只读业务 Tool、Tool Call 审计</description>

    <dependencies>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-common</artifactId>
        </dependency>
        <!-- AI Tools may only call business services, never mappers -->
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-analysis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          Spring AI 2.0: streaming is only supported on the reactive stack.
          The application still runs as a servlet (MVC) app because spring-webmvc
          is present; WebFlux here only supplies Reactor so MVC can adapt Flux return types.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <!--
          业务 MCP 限流（T5-03 / REQ-MCP-03）：QPS 与每日配额都落在 Redis（固定窗口 + 当日 TTL）。
          本模块此前没有任何 Redis 依赖（全模块 redis 0 命中）——限流必须在这里，
          而不是挪到 guarantee-auth/web：MCP 的鉴权、限流、调用编排本来就同属一个模块，
          拆开会让"先限流还是先鉴权"这种顺序问题跨模块隐式耦合。
          整包应用早已通过 guarantee-auth 引入 spring-data-redis，此处不改变部署形态。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
