<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guarantee</groupId>
        <artifactId>guarantee-ai-admin</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>guarantee-ai</artifactId>
    <name>guarantee-ai</name>
    <description>AI 基础能力：会话、SSE 流式聊天、只读业务 Tool、Tool Call 审计</description>

    <dependencies>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-common</artifactId>
        </dependency>
        <!-- AI Tools may only call business services, never mappers -->
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-analysis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          Spring AI 2.0: streaming is only supported on the reactive stack.
          The application still runs as a servlet (MVC) app because spring-webmvc
          is present; WebFlux here only supplies Reactor so MVC can adapt Flux return types.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
