# =====================================================================
#  guarantee-ai-admin .gitignore
#
#  原则：只提交源码与配置；构建产物、依赖、IDE/系统文件一律不入库。
#  注意：gitignore 里后面的规则会覆盖前面的，`!` 例外必须写在对应规则之后。
# =====================================================================

# ---------------------------------------------------------------------
# Maven / Java
# ---------------------------------------------------------------------
target/
build/

# 万一源码目录里出现同名 target 目录，仍要保留
!**/src/main/**/target/
!**/src/test/**/target/

*.class
*.jar
*.war
*.ear
*.nar

# Maven Wrapper 需要入库（若将来引入 mvnw），必须写在 *.jar 之后
!.mvn/wrapper/maven-wrapper.jar

# 若有人把本地仓库配到项目内
.mvn/repository/

# ---------------------------------------------------------------------
# 前端 Node / Vite
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# 环境变量
#   注意：frontend/.env.development 等非敏感默认配置需要入库，不要忽略
# ---------------------------------------------------------------------
.env.local
.env.*.local
*.local

# ---------------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse / MyEclipse
.settings/
.classpath
.project
.factorypath
.apt_generated/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ---------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# 日志与运行时产物
# ---------------------------------------------------------------------
*.log
logs/
hs_err_pid*
replay_pid*
*.pid
*.hprof

# ---------------------------------------------------------------------
# 本地验证/临时目录，防止误提交
# ---------------------------------------------------------------------
.verify*/
.verify-mysql/
.verify8/
tmp/
temp/
