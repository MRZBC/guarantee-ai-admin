<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guarantee</groupId>
        <artifactId>guarantee-ai-admin</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>guarantee-system</artifactId>
    <name>guarantee-system</name>
    <description>系统配置：机构、部门、用户、角色、权限、险种</description>

    <dependencies>
        <dependency>
            <groupId>com.guarantee</groupId>
            <artifactId>guarantee-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          方法级鉴权注解（@PreAuthorize / hasAuthority）。
          SYS-P-01 要求 system:* 接口的权限校验点是**服务端强制**的，而系统管理域的
          Controller 与 Service 都在本模块。这里直接引入 spring-security-core，
          而不是把校验挪到上层 web 模块——后者会让"绕过 Controller 直接调用 Service"
          成为越权缺口（RK-02）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!--
          数据范围与写操作的集成测试需要 Spring 上下文 + 真实 MySQL
          （TEST-03 / TEST-06 / TEST-13 都在这一层验证）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!--
              schema.sql 的唯一来源是 guarantee-web；这里在构建期把它复制进测试资源，
              而不是在 guarantee-system/src/test/resources 里维护第二份副本。

              两份定义会漂移：一旦新表（例如 ai_operation_audit 的分区定义）只加在
              guarantee-web，本模块的集成测试就会在"表不存在"上失败，而且失败原因看起来
              与 schema 无关。用构建期复制把"重复定义"变成不可能。

              seed/region.sql 同理：行政区划字典在集成测试里也要有数据（地区下拉与机构
              区划校验都依赖它），否则测试会以"字典是空的"这种与断言无关的面孔失败。
            -->
            <testResource>
                <directory>${project.basedir}/../guarantee-web/src/main/resources/db</directory>
                <targetPath>db</targetPath>
                <includes>
                    <include>schema.sql</include>
                    <include>seed/region.sql</include>
                </includes>
            </testResource>
        </testResources>
    </build>
</project>
