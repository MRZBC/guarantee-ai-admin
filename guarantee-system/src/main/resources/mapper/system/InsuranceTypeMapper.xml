<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guarantee.system.mapper.InsuranceTypeMapper">

    <sql id="cols">
        id, type_code, type_name, category, base_rate, min_amount, max_amount,
        status, description, created_at, updated_at,
        is_deleted AS isDeleted, deleted_at AS deletedAt, deleted_by AS deletedBy
    </sql>

    <sql id="queryWhere">
        <where>
            <choose>
                <when test="q.includeDeleted != null and q.includeDeleted">
                    <!--
                      「显示已删除」视图（LD-04b）：显式放行 0/1 两种状态。
                      本语句已含 is_deleted，拦截器按约定跳过（避免重复条件），
                      因此默认视图的过滤责任仍在拦截器与显式条件上。
                    -->
                    AND is_deleted IN (0, 1)
                </when>
            </choose>
            <if test="q.typeName != null and q.typeName != ''">
                AND type_name LIKE CONCAT('%', #{q.typeName}, '%')
            </if>
            <if test="q.typeCode != null and q.typeCode != ''">
                AND type_code LIKE CONCAT('%', #{q.typeCode}, '%')
            </if>
            <if test="q.keyword != null and q.keyword != ''">
                AND (type_name LIKE CONCAT('%', #{q.keyword}, '%')
                     OR type_code LIKE CONCAT('%', #{q.keyword}, '%'))
            </if>
            <if test="q.category != null and q.category != ''">
                AND category = #{q.category}
            </if>
            <if test="q.status != null">
                AND status = #{q.status}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/>
        FROM insurance_type
        <include refid="queryWhere"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(*) FROM insurance_type
        <include refid="queryWhere"/>
    </select>

    <select id="selectById" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE id = #{id}
    </select>

    <select id="selectByCode" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE type_code = #{typeCode}
    </select>

    <select id="selectAllEnabled" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE status = 1 ORDER BY id ASC
    </select>

    <!--
      订单筛选下拉的可选险种：**"能筛出数据"的全集** =
        ① 启用中且未删除的险种；或
        ② 被订单引用的险种（不论已停用，还是已逻辑删除）。

      ② 是这条口径的重点：险种一旦被历史订单引用，它的名字就出现在订单列表里，
      筛选下拉就必须还能选到它——否则用户看到的是"列表里有这个险种、筛选里却没有"，
      或者"选了履约保函却是空列表"（现场两个毛病都出现过）。

      两个前提必须写清楚：
      · 应用层对"被订单引用的险种"是**禁止删除**的（险种删除前置检查 / LD-T10），
        因此"已删除 + 被引用"只可能来自**数据库直连删除**（deleted_by = 'DB'）、
        迁移脚本或历史数据。② 是对这条路径的兜底，不是常规路径。
      · 本语句显式含 is_deleted 条件 → 逻辑删除拦截器整句跳过（避免重复注入），
        所以 ① 的 is_deleted = 0 必须自己写；子查询同理（拦截器只管最外层 FROM/JOIN，
        设计 §5.2，与 countOrderByType 同一写法），漏写会把已删订单算作"仍在引用"。
    -->
    <select id="selectFilterOptions" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/>
        FROM insurance_type
        WHERE (status = 1 AND is_deleted = 0)
           OR EXISTS (SELECT 1 FROM tender_order t
                       WHERE t.insurance_type_id = insurance_type.id AND t.is_deleted = 0)
           OR EXISTS (SELECT 1 FROM performance_order p
                       WHERE p.insurance_type_id = insurance_type.id AND p.is_deleted = 0)
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO insurance_type
            (type_code, type_name, category, base_rate, min_amount, max_amount, status, description)
        VALUES
            (#{typeCode}, #{typeName}, #{category}, #{baseRate}, #{minAmount}, #{maxAmount},
             #{status}, #{description})
    </insert>

    <update id="updateById">
        UPDATE insurance_type
        <set>
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="baseRate != null">base_rate = #{baseRate},</if>
            <if test="minAmount != null">min_amount = #{minAmount},</if>
            <if test="maxAmount != null">max_amount = #{maxAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 条件更新状态：只有当前状态与预期一致时才改（T-08） -->
    <update id="updateStatus">
        UPDATE insurance_type SET status = #{status} WHERE id = #{id} AND status = #{expectedStatus}
    </update>

    <select id="selectCandidates" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/>
        FROM insurance_type
        <where>
            <if test="keyword != null and keyword != ''">
                AND (type_name LIKE CONCAT('%', #{keyword}, '%')
                     OR type_code LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <!-- 停用前置检查：该险种被多少条订单引用（含投标与履约） -->
    <select id="countOrderByType" resultType="long">
        SELECT (SELECT COUNT(*) FROM tender_order
                 WHERE insurance_type_id = #{id} AND is_deleted = 0)
             + (SELECT COUNT(*) FROM performance_order
                 WHERE insurance_type_id = #{id} AND is_deleted = 0)
    </select>

    <!--
      逻辑删除（设计 §9.4.1）：三列必须在**同一条语句**里写全。
      只写一半会让唯一键判定错乱，且现象与原因看起来无关，极难排查（风险 LD-R10）。
      deleted_at 必须用 NOW(6)（微秒精度），否则同一秒内"删除→重建→再删除"会撞唯一键；
      AND is_deleted = 0 让重复删除的 ROW_COUNT() 为 0，调用方据此判定并发冲突。
    -->
    <update id="softDelete">
        UPDATE insurance_type
        SET is_deleted = 1,
            deleted_at = NOW(6),
            deleted_by = COALESCE(#{operatorId}, 'DB')
        WHERE id = #{id} AND is_deleted = 0
    </update>

    <!-- 恢复（设计 §9.4.2 / LD-04）：三列一起归零，只允许从"已删除"恢复 -->
    <update id="restore">
        UPDATE insurance_type
        SET is_deleted = 0,
            deleted_at = NULL,
            deleted_by = 'DB'
        WHERE id = #{id} AND is_deleted = 1
    </update>

    <!-- 恢复前的读取（IncludingDeleted 后缀 → 拦截器豁免） -->
    <select id="selectByIdIncludingDeleted" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE id = #{id}
    </select>

</mapper>
