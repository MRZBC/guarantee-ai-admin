<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guarantee.system.mapper.InsuranceTypeMapper">

    <sql id="cols">
        id, type_code, type_name, category, base_rate, min_amount, max_amount,
        status, description, created_at, updated_at
    </sql>

    <sql id="queryWhere">
        <where>
            <if test="q.typeName != null and q.typeName != ''">
                AND type_name LIKE CONCAT('%', #{q.typeName}, '%')
            </if>
            <if test="q.category != null and q.category != ''">
                AND category = #{q.category}
            </if>
            <if test="q.status != null">
                AND status = #{q.status}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/>
        FROM insurance_type
        <include refid="queryWhere"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(*) FROM insurance_type
        <include refid="queryWhere"/>
    </select>

    <select id="selectById" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE id = #{id}
    </select>

    <select id="selectByCode" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE type_code = #{typeCode}
    </select>

    <select id="selectAllEnabled" resultType="com.guarantee.system.entity.InsuranceType">
        SELECT <include refid="cols"/> FROM insurance_type WHERE status = 1 ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO insurance_type
            (type_code, type_name, category, base_rate, min_amount, max_amount, status, description)
        VALUES
            (#{typeCode}, #{typeName}, #{category}, #{baseRate}, #{minAmount}, #{maxAmount},
             #{status}, #{description})
    </insert>

    <update id="updateById">
        UPDATE insurance_type
        <set>
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="baseRate != null">base_rate = #{baseRate},</if>
            <if test="minAmount != null">min_amount = #{minAmount},</if>
            <if test="maxAmount != null">max_amount = #{maxAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
