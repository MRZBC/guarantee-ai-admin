<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guarantee</groupId>
        <artifactId>guarantee-ai-admin</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>guarantee-common</artifactId>
    <name>guarantee-common</name>
    <description>统一响应、异常、TraceId、分页、通用工具</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
          仅为在 GlobalExceptionHandler 里**按类型**处理方法级鉴权的拒绝
          （org.springframework.security.access.AccessDeniedException，@PreAuthorize 实际抛其子类
          AuthorizationDeniedException）。不显式处理时，异常会落进兜底的
          @ExceptionHandler(Exception.class)，把"权限不足"误报成 500「系统内部错误」。

          注意这里刻意用 **spring-security-core** 而不是 spring-boot-starter-security：
          它只带来注解与异常类型，不会引入 Security 的自动配置与认证过滤器链
          （本项目只有 guarantee-web 需要那套东西）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
    </dependencies>
</project>
