{
  "name": "knowledge-os-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Knowledge OS — standard MCP server (stdio) for a per-project Obsidian Vault. Runtime-agnostic: implements MCP only.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
